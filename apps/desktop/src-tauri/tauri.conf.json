{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DentLink",
  "version": "0.0.0",
  "identifier": "com.dentlink.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @dentlink/desktop dev:ui",
    "devUrl": "http://127.0.0.1:5180",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DentLink",
        "width": 1920,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["../../../icons/DL.png"]
  }
}
