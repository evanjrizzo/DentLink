{
  "name": "dentlink",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22 <23",
    "pnpm": "9.15.4"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "wrangler dev --local",
    "db:migrate:local": "wrangler d1 migrations apply dentlink --local",
    "db:migrate:preview": "wrangler d1 migrations apply dentlink-preview --env preview --remote",
    "db:migrate:production": "wrangler d1 migrations apply dentlink-production --env production --remote",
    "deploy:preview": "wrangler deploy --env preview",
    "deploy:production": "wrangler deploy --env production",
    "deploy:web:preview": "wrangler pages deploy apps/web/dist --project-name dentlink-web-preview --branch development",
    "smoke:api": "node scripts/smoke-api.mjs",
    "test:browser": "playwright test",
    "format": "prettier --write \"**/*.{css,html,json,yaml,yml,js,mjs,ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{css,html,json,yaml,yml,js,mjs,ts,tsx}\"",
    "lint": "eslint .",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "wrangler": "^4.110.0"
  }
}
